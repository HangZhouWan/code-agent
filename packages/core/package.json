{
  "name": "@code-agent/core",
  "version": "0.1.0",
  "description": "Core library for code-agent — LLM abstraction, tools, agent runtime, memory, and sandbox",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@langchain/anthropic": "^1.0.0",
    "langchain": "^1.0.0",
    "zod": "^3.25.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "keywords": [
    "code-agent",
    "ai",
    "llm",
    "agent",
    "coding-assistant"
