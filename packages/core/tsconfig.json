{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 输出目录
    "outDir": "./dist",
    // 源码根目录
    "rootDir": "./src",
    // 参与 project references 增量构建
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  // 仅编译 src 目录下的文件
  "include": ["src"],
  "references": [{ "path": "../protocol" }]
}