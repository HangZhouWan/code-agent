{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 前端使用 DOM 类型
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // JSX 编译模式：React 17+ 的 automatic 模式
    "jsx": "react-jsx",
    // 输出目录
    "outDir": "./dist",
    // 前端不需要 .d.ts 生成（Vite 负责打包）
    "declaration": false,
    "declarationMap": false
  },
  // 编译 src 和 vite 配置文件
  "include": ["src", "vite.config.ts"],
  // 排除测试文件（测试由 vitest 单独运行，无需 tsc 编译）
  "exclude": ["node_modules", "dist", "src/**/__tests__", "src/**/*.test.*", "src/**/*.spec.*"]
}