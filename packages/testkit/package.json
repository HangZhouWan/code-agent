{
  "name": "@code-agent/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test fakes and fixtures for code-agent packages (dev-only)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  }
}
