{
  "name": "code-agent",
  "version": "0.1.0",
  "description": "CLI for code-agent — Claude Code-style AI coding assistant for any workspace",
  "type": "module",
  "bin": {
    "code-agent": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/bundle.js",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "langchain": "^1.0.0",
    "simple-git": "^3.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@code-agent/core": "workspace:^",
    "@code-agent/server": "workspace:^",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "code-agent",
    "ai",
    "cli",
    "coding-assistant",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qichen/code-agent"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
