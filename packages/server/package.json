{
  "name": "@code-agent/server",
  "version": "0.1.0",
  "description": "Server for code-agent — LangGraph orchestrator, WebSocket gateway, and database layer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./orchestrator": {
      "import": "./dist/orchestrator/graph.js",
      "types": "./dist/orchestrator/graph.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@code-agent/core": "workspace:^",
    "fastify": "^5.3.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "better-sqlite3": "^11.8.0",
    "drizzle-orm": "^0.42.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/ws": "^8.5.0",
    "drizzle-kit": "^0.30.0"
  },
  "keywords": [
    "code-agent",
    "ai",
    "orchestrator",
    "langgraph",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qichen/code-agent"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}