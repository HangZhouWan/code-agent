{
  "name": "code-agent",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "cli": "pnpm --filter @code-agent/cli dev",
    "build": "pnpm -r build",
    "publish:cli": "pnpm --filter @code-agent/cli publish:npm",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
