{
  "name": "code-agent",
  "private": true,
  "scripts": {
    "generate:prompts": "pnpm --filter @code-agent/runtime generate:prompts",
    "build:refs": "pnpm generate:prompts && tsc -b",
    "dev": "pnpm build:refs && pnpm --parallel -r --filter @code-agent/server --filter @code-agent/web dev",
    "dev:server": "pnpm build:refs && pnpm --filter @code-agent/server dev",
    "dev:web": "pnpm build:refs && pnpm --filter @code-agent/web dev",
    "dev:cli": "pnpm build:refs && pnpm --filter @code-agent/cli dev",
    "cli": "pnpm build:refs && pnpm --filter @code-agent/cli dev",
    "clean": "node -e \"const fs=require('fs');for(const p of fs.readdirSync('packages'))fs.rmSync('packages/'+p+'/dist',{recursive:true,force:true})\"",
    "build": "pnpm -r build",
    "publish:cli": "pnpm --filter @code-agent/cli publish:npm",
    "lint": "eslint packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:bundle": "node packages/cli/scripts/check-bundle.js",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:bundle"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
