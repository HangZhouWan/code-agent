# ============================================
# LLM Provider 配置
# ============================================

# Anthropic API Key（Claude 模型）
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key（GPT 模型）
OPENAI_API_KEY=sk-...

# ============================================
# Server 配置
# ============================================

# 服务端口号
PORT=3000

# 服务主机地址
HOST=0.0.0.0

# 日志级别：trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================
# 数据库配置
# ============================================

# SQLite 数据库文件路径
DATABASE_URL=./data/my-agent.db

# ============================================
# Web 前端配置
# ============================================

# Vite dev server 端口
VITE_PORT=5173

# API 代理目标（开发环境）
VITE_API_PROXY=http://localhost:3000