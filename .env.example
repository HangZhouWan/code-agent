# ============================================
# LLM Provider 配置
# ============================================

# LLM 提供商: openai / anthropic / openai-compatible
LLM_PROVIDER=openai

# 模型名称，如 gpt-4o / claude-opus-4-8
LLM_MODEL=gpt-4o

# API 密钥（必填）
LLM_API_KEY=sk-...

# 自定义 API 端点，用于代理或兼容服务（可选）
# LLM_BASE_URL=https://api.openai.com/v1

# 最大重试次数，默认 3
# LLM_MAX_RETRIES=3

# ============================================
# Server 配置
# ============================================

# 服务主机地址
HOST=0.0.0.0

# 服务端口号
PORT=3000

# 工作区根路径
# WORKSPACE_PATH=./workspace

# ============================================
# 数据库配置
# ============================================

# SQLite 数据库文件路径
DB_PATH=./data/my-agent.db
