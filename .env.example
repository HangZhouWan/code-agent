# ============================================
# LLM Provider 配置
# ============================================

# LLM 提供商: openai / anthropic / openai-compatible
LLM_PROVIDER=openai

# 模型名称，如 gpt-4o / claude-opus-4-8
LLM_MODEL=gpt-4o

# API 密钥（必填）
LLM_API_KEY=sk-...

# 自定义 API 端点，用于代理或兼容服务（可选）
# LLM_BASE_URL=https://api.openai.com/v1

# 最大重试次数，默认 3
# LLM_MAX_RETRIES=3

# 单次输出最大 token 数（anthropic 默认 8192；生成大文件时不要设置过小）
# LLM_MAX_TOKENS=8192

# ============================================
# Server 配置
# ============================================

# 服务主机地址（默认仅本机；需要局域网访问时改为 0.0.0.0）
HOST=127.0.0.1

# 服务端口号
PORT=3000

# 工作区根路径
# WORKSPACE_PATH=./workspace

# Auto mode：工作区内写文件/改文件/执行命令免人工审批（默认关闭）
# AUTO_MODE=false

# ============================================
# 数据库配置
# ============================================

# SQLite 数据库文件路径（默认 <workspace>/.agent/data/code-agent.db）
# DB_PATH=.agent/data/code-agent.db

# ============================================
# 上下文压缩 / 记忆（可选）
# ============================================

# ============================================
# LangSmith 追踪（可选）
# ============================================

# 开启后 LangChain / LangGraph 的调用链会上报到 LangSmith。
# 也兼容旧变量名：LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY / LANGCHAIN_PROJECT
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=code-agent

# 自建 LangSmith 端点（可选）
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 只上报调用结构，不上报输入输出内容（可选，建议用于私有代码库）
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# CONTEXT_SOFT_THRESHOLD=0.75
# CONTEXT_HARD_THRESHOLD=0.9
# SUMMARY_MAX_TOKENS=2000
# SUMMARY_MODEL=gpt-4o-mini
# MEMORY_MODEL=gpt-4o-mini
